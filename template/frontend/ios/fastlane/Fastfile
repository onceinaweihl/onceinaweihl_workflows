# Template for <working_dir>/ios/fastlane/Fastfile.
#
# The deploy-ios job in onceinaweihl_workflows' reusable-cd.yml calls these
# lanes by name, and scripts/deploy_ios.sh should call the same ones, so a
# local deploy and a CI deploy sign, number and upload alike:
#
#   sync_certificates   install certificates and profiles via match (read-only)
#   next_build_number   write the next free build number to build/next_build_number
#   beta                upload build/ios/ipa/*.ipa to TestFlight
#   release             upload it and submit it for App Store review
#   upload_screenshots  upload fastlane/screenshots/ (CD only with has_screenshots)
#
# Next to it: ios/Gemfile with gem "fastlane", fastlane/Appfile
# (app_identifier, team_id) and fastlane/Matchfile (git_url, type "appstore").
# The App Store Connect API key comes from APP_STORE_CONNECT_API_KEY_ID,
# APP_STORE_CONNECT_API_KEY_ISSUER_ID and APP_STORE_CONNECT_API_KEY_CONTENT,
# match reads MATCH_PASSWORD and MATCH_GIT_BASIC_AUTHORIZATION.

default_platform(:ios)

# Absolute paths, so the lanes work whether fastlane runs from ios/ (CD,
# scripts/deploy_ios.sh) or from ios/fastlane/ (manual).
IPA_GLOB = File.expand_path("../../build/ios/ipa/*.ipa", __dir__)
# Written by `next_build_number`, read by the CD workflow and scripts/deploy_ios.sh.
BUILD_NUMBER_PATH = File.expand_path("../../build/next_build_number", __dir__)

platform :ios do
  desc "Sync certificates and profiles via Match (read-only)"
  lane :sync_certificates do
    # On CI a temporary, unlocked keychain. In the login keychain codesign
    # asks for permission, and the runner waits for a click until the job
    # times out. Does nothing outside CI.
    setup_ci
    match(api_key: asc_api_key, type: "appstore", readonly: true)
  end

  # The latest upload of any version + 1; uploads still processing or failed
  # count too. Build numbers only ever go up, so the latest upload is also
  # the highest.
  desc "Write the next free build number to build/next_build_number"
  lane :next_build_number do
    latest = latest_testflight_build_number(api_key: asc_api_key, initial_build_number: 0)
    UI.user_error!("Latest build number #{latest.inspect} is not a whole number") unless latest.is_a?(Integer)

    FileUtils.mkdir_p(File.dirname(BUILD_NUMBER_PATH))
    File.write(BUILD_NUMBER_PATH, (latest + 1).to_s)
    UI.success("Next build number: #{latest + 1}")
  end

  desc "Upload the Flutter-built IPA to TestFlight"
  lane :beta do
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: locate_ipa,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Upload the Flutter-built IPA and submit it for App Store review"
  lane :release do
    deliver(
      api_key: asc_api_key,
      ipa: locate_ipa,
      submit_for_review: true,
      automatic_release: false,
      # No HTML preview to confirm; on CI nobody would.
      force: true,
      # Carries release_notes.txt, the "What's New" an update needs.
      metadata_path: "fastlane/metadata/",
      screenshots_path: "fastlane/screenshots/",
      overwrite_screenshots: true,
      # Precheck cannot read in-app purchases with an API key and would fail.
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Upload screenshots only (no binary)"
  lane :upload_screenshots do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      screenshots_path: "fastlane/screenshots/",
      overwrite_screenshots: true,
      skip_metadata: true,
      force: true,
      run_precheck_before_submit: false,
      ignore_language_directory_validation: true,
    )
  end

  def locate_ipa
    matches = Dir.glob(IPA_GLOB)
    UI.user_error!("No IPA found matching #{IPA_GLOB}. Run `flutter build ipa --release` first.") if matches.empty?
    matches.first
  end

  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT"),
      is_key_content_base64: false,
    )
  end
end
